# Replace change-me before using this environment for anything real.
# MongoDB applies this password only when its data volume is first created.
# Put TLS certificates in nginx/certs and uncomment the 443 server in nginx/production.conf.

APP_ENV=production
COMPOSE_PROJECT_NAME=quicksetup-prod
LOG_LEVEL=warning

MONGO_DB=app
MONGO_USER=app
MONGO_PASSWORD=change-me
MONGO_URI=mongodb://app:change-me@mongo:27017/app?authSource=admin

REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379/0
CACHE_URL=redis://:change-me@redis:6379/1

WEB_CONCURRENCY=4
CORS_ORIGINS=http://localhost

FRONTEND_PORT=5173
API_PORT=8000
MONGO_PORT=27017
REDIS_PORT=6379
PROXY_HTTP_PORT=80
