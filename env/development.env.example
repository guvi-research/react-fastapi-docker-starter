# Host ports below are published on your machine.
# MONGO_URI and REDIS_URL always use the container DNS names and container ports.

APP_ENV=development
COMPOSE_PROJECT_NAME=quicksetup-dev
LOG_LEVEL=debug

MONGO_DB=app
MONGO_USER=
MONGO_PASSWORD=
MONGO_URI=mongodb://mongo:27017/app

REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1

WEB_CONCURRENCY=1
CORS_ORIGINS=http://localhost:5173

FRONTEND_PORT=5173
API_PORT=8000
MONGO_PORT=27017
REDIS_PORT=6379
PROXY_HTTP_PORT=8080
